<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <AssemblyName>SeedTotem</AssemblyName>
    <RootNamespace>SeedTotem</RootNamespace>
    <Version>4.3.9</Version>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>portable</DebugType>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="JotunnLib" Version="2.30.0" PrivateAssets="all" />
  </ItemGroup>

  <!-- Keep all game/loader references external. The current Valheim install and BepInEx
       pack are supplied by the build workflow or by Environment.props on a dev machine. -->
  <ItemGroup>
    <Reference Include="$(VALHEIM_MANAGED)/assembly_valheim.dll" Publicize="true" Private="false" />
    <Reference Include="$(VALHEIM_MANAGED)/assembly_utils.dll" Publicize="true" Private="false" />
    <Reference Include="$(BEPINEX_PATH)/core/BepInEx.dll" Private="false" />
    <Reference Include="$(BEPINEX_PATH)/core/0Harmony.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <UnityAssembly Include="$(VALHEIM_MANAGED)/UnityEngine*.dll" />
    <UnityAssembly Include="$(VALHEIM_MANAGED)/Unity.TextMeshPro.dll" />
    <Reference Include="@(UnityAssembly)" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="EmbeddedAssets\seedtotem" />
    <None Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyToPluginFolder" AfterTargets="Build" Condition="'$(DeployDir)' != '' AND Exists('$(DeployDir)')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DeployDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
